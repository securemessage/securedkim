# SecureDKIM Configuration
# See securedkim(8) for details.

[global]
# Identifier used in Authentication-Results headers.
AuthservID      = mail.example.com

# Trust boundary (RFC 8601 section 5).
# SecureDKIM always removes pre-existing Authentication-Results headers that
# claim our AuthservID and assert a dkim= result, since a remote sender must
# not be able to supply its own DKIM verdict.
# Set this to yes only when SecureDKIM is the FIRST milter in the chain, to
# additionally remove every other Authentication-Results header claiming our
# AuthservID. With SecureSPF in front of it, leave this unset and set
# StripAuthResults there instead.
# StripAuthResults = no

# Number of worker threads. 0 = auto-detect CPU count.
WorkerThreads   = 0

# Maximum simultaneous connections accepted by each worker thread.
# Default: 256.
# MaxConnections = 256

# Syslog logging.
Syslog          = yes
SyslogFacility  = mail

# Logging verbosity: err, warn, info, debug.
# LogLevel      = info

# PID file location.
PidFile         = /var/run/securedkim/securedkim.pid

# Drop privileges to this user, as "user" or "user:group".
#
# The drop happens BEFORE the listeners are bound, so a unix socket is created
# owned by this user and group, and the directory it lives in must be writable
# by them.
#
# Name the group the MTA runs in and the socket can be shared with Postfix and
# nothing else. That matters more for this daemon than for the others: a
# signing socket will sign what it is given, so anything that can connect to it
# can have mail signed as your domain.
User            = mailnull

# File-creation mask for the PID file and any unix-domain listener.
#
# Read as OCTAL whether or not you write the leading zero. Unset inherits the
# supervisor's mask, which for a unix socket means 0755 -- connectable by every
# local account, i.e. an unauthenticated signing oracle for anyone with a shell.
#
# 0117 gives a socket at 0660: owner and group only. Pair it with a group in
# User above. A socket takes its mode from the umask at bind time, so this is
# the only control there is.
#
# Does not apply to the TCP listener below, which has no filesystem
# permissions.
# UMask         = 0117

# Run in foreground (do not daemonize). Useful for debugging.
# Foreground    = no

# DNS resolver settings.
DnsNameserver   = 127.0.0.1
DnsTimeout      = 5
DnsRetries      = 2

# Maximum entries in the per-worker DNS cache, and the TTL in seconds applied
# to negative answers (NXDOMAIN, SERVFAIL) so a lookup that just failed is not
# retried on every message.
# DnsCacheSize    = 1000
# DnsNegativeTTL  = 60

# Headers to include in DKIM signature.
SignedHeaders   = from:to:subject:date:message-id

# Headers to oversign: listed one more time than the message contains them, so
# that a mailing list or forwarder adding another instance later breaks the
# signature rather than silently going unnoticed. Spelled as OpenDKIM spells
# it, so a migrated opendkim.conf line works verbatim. Default: from. Empty
# disables oversigning.
# OverSignHeaders = from

# --- Resource limits on attacker-controlled message content ---
#
# All four take effect at startup, not on SIGHUP. Setting any of them to 0
# disables that limit entirely, which restores the unbounded behaviour.

# Largest message body this daemon will buffer in order to hash it.
# Accepts a K/M/G suffix. Default 10M.
#
# Set this at or above Postfix's message_size_limit. A body over the limit is
# not hashed and not truncated: verification reports dkim=temperror and signing
# is skipped, because a body hash over a partial copy would describe a message
# the MTA is not delivering.
# MaxBodyBytes  = 10M

# Largest number of headers, and largest total header size, this daemon will
# accumulate. Defaults 500 and 1M.
#
# A message whose header block exceeds either is tempfailed rather than
# delivered: headers past the limit are never seen, so a forged
# Authentication-Results hidden beyond it could not be stripped. Raise these if
# legitimate mail crossing many forwarders and mailing lists is being deferred.
# MaxHeaders    = 500
# MaxHeaderBytes = 1M

# Largest number of DKIM-Signature headers to verify in one message.
# Default 20, matching OpenDKIM's MaxSignatures.
#
# Each signature costs a DNS lookup and an RSA verify, so an unbounded count is
# remote CPU and DNS amplification. Past the limit no signature is verified and
# the result is dkim=permerror.
# MaxSignatures = 20

# --- Minimum signer key size ---

# Smallest RSA key, in bits, accepted from a signer's DNS key record.
# Default 1024.
#
# Note the asymmetry with the MaxNNN limits above: 0 does NOT disable this one.
# RFC 8301 section 3.2 says verifiers "MUST NOT consider signatures using RSA
# keys of less than 1024 bits as valid signatures", so a value below 1024 is
# raised to 1024 and a warning is logged. A 512-bit modulus is factorable for a
# few hundred dollars, which would make dkim=pass mean nothing while DMARC went
# on treating it as an authenticated identity.
#
# A signature below the limit gets dkim=permerror, which is what RFC 8301 calls
# for: such signatures "have permanently failed evaluation".
#
# Raise this to 2048 to match the RFC's SHOULD for signers. Be aware that doing
# so will permerror mail from any correspondent still publishing a 1024-bit key,
# which is legal and still reasonably common.
#
# This applies only to keys other people publish. This daemon's own signing key
# is always held to the 1024-bit floor regardless of what is set here, because
# mail signed below it fails DKIM at every conformant verifier.
# MinimumKeyBits = 1024

# How many TXT key records to try at a selector before failing a signature.
# Default: 3. Values above 8 are capped at 8.
#
# A domain rotating keys legitimately publishes two records at one selector,
# and RRset order is unspecified and commonly rotated by resolvers. Taking only
# the first record would make the same message verify on one lookup and fail
# on the next -- intermittent dkim=fail for a correctly configured domain,
# feeding intermittent DMARC failures. Cycling the usable records, as RFC 6376
# 6.1.2 step 4 permits, avoids that intermittency. The bound exists because
# the record count is the zone owner's choice and each record tried costs
# another public-key verification.
#
# Read at startup only; SIGHUP does not pick up a change.
# MaxKeyRecords = 3

# --- Evaluation time budget ---
#
# MaxEvaluationMs is the wall-clock ceiling in milliseconds for evaluating one
# message, shared by every DNS lookup the verdict needs. Exhausting it gives
# temperror, never fail: the message was not judged, and the sender retries.
# A slow resolver, not a hostile sender, is what it guards against.
#
# 0 disables it. Takes effect at startup; SIGHUP does not pick up a change.
# MaxEvaluationMs = 20000

# What a signature's l= tag means: honor or refuse. Default: honor.
#
# l= says how many octets of the canonicalized body the signature covers, so that
# a mailing list appending a footer does not break the original signature. What it
# also means is that an intermediary can append content the signer never saw while
# the signature keeps validating -- RFC 6376 8.2 notes the appended part can
# "completely replace the original content in the end recipient's eyes", and
# concludes that "Assessors might wish to ignore signatures that use the tag".
#
# honor  obeys the tag per RFC 6376 3.5, and logs a warning naming the domain and
#        the number of unsigned octets whenever a pass covers only part of a body.
# refuse declines to evaluate such signatures at all, reporting dkim=policy.
#        Signatures without l= are unaffected.
#
# Both are conformant. l= is rare, and RFC 6377 3.5 discourages using it.
# BodyLengthTag = honor

# ZMQ event publishing endpoint (optional).
# ZmqEndpoint   = tcp://events.internal:5555

# ZeroMQ topic prefix events are published under. Default: dkim.
# ZmqTopic      = dkim

# Each listener has its own Mode: sign, verify, or both, and each is
# independent of the others. A listener that omits Mode inherits a [global]
# Mode if one is set, otherwise verify. An unrecognised value is refused at
# startup rather than silently falling back. Confirm the "listener[N]
# mode=..." lines logged at startup match what you intended, particularly
# when a sign section and a verify section both appear below.

# --- Verify inbound DKIM signatures ---
# Loopback, like the signing socket below. "Inbound" describes the mail, not this
# socket: the connection is from the local Postfix, never from the internet. The
# milter protocol has no authentication, so anything that can reach this port
# dictates the Authentication-Results this host stamps without having to forge
# a header. Widen it only if Postfix is genuinely on another machine, and then
# restrict it with pf.
[listener:verify-inbound]
# The address must be numeric: no DNS is performed, so inet:PORT@localhost is a
# configuration ERROR, not a synonym for 127.0.0.1. A Socket value that cannot be
# parsed stops startup and names this section; it is never silently ignored and
# never falls back to the default listener.
Socket          = inet:8891@127.0.0.1
Mode            = verify

# --- Sign outbound mail (multi-domain via SigningTable/KeyTable) ---
# Bound to loopback deliberately: only the local MTA submits to the signing
# socket, and anything that can reach it can have mail signed by this host.
# [listener:sign-outbound]
# Socket          = inet:8892@127.0.0.1
# Mode            = sign
# SigningTable    = /var/db/securedkim/signing-table
# KeyTable        = /var/db/securedkim/key-table

# --- Sign outbound mail (single domain shorthand) ---
# [listener:sign-outbound]
# Socket          = inet:8892@127.0.0.1
# Mode            = sign
# Domain          = example.com
# Selector        = dkim2026
# KeyFile         = /var/db/securedkim/keys/example.com.key
